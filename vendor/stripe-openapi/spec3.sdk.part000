            "x-expansionResources": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/billing.feedback_option"
                }
              ]
            }
          },
          "reason": {
            "description": "Why this subscription was canceled.",
            "enum": [
              "canceled_by_retention_policy",
              "cancellation_requested",
              "payment_disputed",
              "payment_failed"
            ],
            "nullable": true,
            "type": "string",
            "x-stripeEnum": {
              "kind": "open",
              "values": [
                {
                  "description": "Canceled because our [retention policy](https://support.stripe.com/questions/test-mode-subscription-data-retention) automatically expires subscriptions with `livemode: false`.",
                  "value": "canceled_by_retention_policy"
                },
                {
                  "description": "Canceled explicitly through the API or Dashboard.",
                  "value": "cancellation_requested"
                },
                {
                  "description": "Canceled automatically after a dispute was opened, according to your [billing settings](https://dashboard.stripe.com/settings/billing/subscriptions).",
                  "value": "payment_disputed"
                },
                {
                  "description": "Canceled automatically after payment failure, according to your [billing settings](https://dashboard.stripe.com/settings/billing/subscriptions).",
                  "value": "payment_failed"
                }
              ]
            }
          }
        },
