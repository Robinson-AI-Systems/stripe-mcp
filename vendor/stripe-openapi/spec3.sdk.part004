      "payments_primitives_payment_records_resource_payment_method_card_details_resource_three_d_secure": {
        "description": "",
        "properties": {
          "authentication_flow": {
            "description": "For authenticated transactions: Indicates how the issuing bank authenticated the customer.",
            "enum": [
              "challenge",
              "frictionless"
            ],
            "nullable": true,
            "type": "string"
          },
          "electronic_commerce_indicator": {
            "description": "The Electronic Commerce Indicator (ECI). A protocol-level field indicating what degree of authentication was performed.",
            "enum": [
              "01",
              "02",
              "03",
              "04",
              "05",
              "06",
              "07"
            ],
            "nullable": true,
            "type": "string",
            "x-stripeEnum": {
              "kind": "open",
              "values": [
                {
                  "description": "**Mastercard variant:** Attempt acknowledged.",
                  "value": "01"
                },
                {
                  "description": "**Mastercard variant:** Fully authenticated.",
                  "value": "02"
                },
                {
                  "value": "03"
                },
                {
                  "value": "04"
                },
                {
                  "description": "Fully authenticated. The customer likely proved their identity to the issuing bank.",
                  "value": "05"
                },
                {
                  "description": "Attempt acknowledged. The customer, or the entire issuing bank, is not\nset up for 3D Secure. Or the issuing bank is experiencing an outage.\n\n**Mastercard variant:** Acquirer SCA exemption.",
                  "value": "06"
                },
                {
                  "description": "**Mastercard variant:** Fully authenticated recurring transaction.",
                  "value": "07"
                }
              ]
            }
          },
          "exemption_indicator": {
            "description": "The exemption requested via 3DS and accepted by the issuer at authentication time.",
            "enum": [
              "low_risk",
              "none"
            ],
            "nullable": true,
            "type": "string",
            "x-stripeEnum": {
              "kind": "open",
              "values": [
                {
                  "description": "Transaction Risk Analysis (TRA) was performed, a low risk exemption was requested via 3DS and granted by the issuer.",
                  "value": "low_risk"
                },
                {
                  "description": "No exemption was requested via 3DS; or, if requested, it was not granted by the issuer.",
                  "value": "none"
                }
              ]
            }
          },
          "exemption_indicator_applied": {
            "description": "Whether Stripe requested the value of `exemption_indicator` in the transaction. This will depend on the outcome of Stripe's internal risk assessment.",
            "nullable": true,
            "type": "boolean"
          },
          "result": {
            "description": "Indicates the outcome of 3D Secure authentication.",
            "enum": [
              "attempt_acknowledged",
              "authenticated",
              "data_share_only",
              "exempted",
              "failed",
              "not_supported",
              "processing_error"
            ],
            "nullable": true,
            "type": "string"
          },
          "result_reason": {
            "description": "Additional information about why 3D Secure succeeded or failed, based on the `result`.",
            "enum": [
              "abandoned",
              "bypassed",
              "canceled",
              "card_not_enrolled",
              "network_not_supported",
              "protocol_error",
              "rejected"
            ],
            "nullable": true,
            "type": "string"
          },
          "version": {
            "description": "The version of 3D Secure that was used.",
            "enum": [
              "1.0.2",
              "2.1.0",
              "2.2.0",
              "2.3.0",
              "2.3.1"
            ],
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "authentication_flow",
          "electronic_commerce_indicator",
          "exemption_indicator",
          "exemption_indicator_applied",
          "result",
          "result_reason",
          "version"
        ],
        "title": "PaymentsPrimitivesPaymentRecordsResourcePaymentMethodCardDetailsResourceThreeDSecure",
        "type": "object",
        "x-expandableFields": [],
        "x-stripeMostCommon": [
          "authentication_flow",
          "electronic_commerce_indicator",
          "exemption_indicator",
          "exemption_indicator_applied",
          "result",
          "result_reason",
          "version"
        ]
