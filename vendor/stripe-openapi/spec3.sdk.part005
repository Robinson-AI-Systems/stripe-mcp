        "description": "The Pause Collection settings determine how we will pause collection for this subscription and for how long the subscription\nshould be paused.",
        "properties": {
          "behavior": {
            "description": "The payment collection behavior for this subscription while paused.",
            "enum": [
              "keep_as_draft",
              "mark_uncollectible",
              "void"
            ],
            "type": "string",
            "x-stripeBypassValidation": true,
            "x-stripeEnum": {
              "kind": "open",
              "values": [
                {
                  "description": "Keep all invoices as `draft` while collection is paused.",
                  "value": "keep_as_draft"
                },
                {
                  "description": "Mark all invoices as `uncollectible` while collection is paused.",
                  "value": "mark_uncollectible"
