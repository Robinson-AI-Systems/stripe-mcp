      "subscription_schedules_resource_pause_schedule_resume_settings": {
        "description": "",
        "properties": {
          "billing_cycle_anchor": {
            "description": "The billing cycle anchor that applies when the subscription is resumed.",
            "enum": [
              "resume_at",
              "unchanged"
            ],
            "type": "string",
            "x-stripeEnum": {
              "kind": "open",
              "values": [
                {
                  "description": "Set the billing cycle anchor to the date the subscription resumes.",
                  "value": "resume_at"
                },
                {
                  "description": "Keep the existing billing cycle anchor.",
                  "value": "unchanged"
                }
              ]
            }
          },
          "payment_behavior": {
            "description": "Controls whether Stripe attempts payment on the resumption invoice and how that affects the subscription's status.",
            "enum": [
              "resume_on_payment_attempt",
              "resume_on_payment_success"
            ],
            "type": "string",
            "x-stripeEnum": {
              "kind": "open",
              "values": [
                {
                  "description": "If you create a resumption invoice, Stripe finalizes the invoice immediately but doesn't attempt payment. You can then manually attempt payment on the invoice using the [Pay invoice endpoint](/api/invoices/pay). If the payment attempt succeeds, the subscription becomes `active`. If the payment attempt fails, the subscription becomes `past_due`. If the invoice has no payment attempts after 23 hours, Stripe voids the invoice and the subscription remains `paused`.",
                  "value": "resume_on_payment_attempt"
                },
                {
                  "description": "If you create a resumption invoice, Stripe finalizes and attempts payment on the invoice immediately. If that payment attempt succeeds, the subscription becomes `active`. If that payment attempt fails, the subscription remains `paused`. You can then manually attempt payment on the invoice using the [Pay invoice endpoint](/api/invoices/pay). If the invoice isn't paid successfully within 1 year of its creation, Stripe voids the invoice and the subscription remains `paused`.",
                  "value": "resume_on_payment_success"
                }
              ]
            }
          },
          "proration_behavior": {
            "description": "Determines how to handle prorations resulting from the billing_cycle_anchor change on resume.",
            "enum": [
              "always_invoice",
              "create_prorations",
              "none"
            ],
            "type": "string"
          }
        },
        "required": [
          "billing_cycle_anchor",
          "payment_behavior",
          "proration_behavior"
        ],
        "title": "SubscriptionSchedulesResourcePauseScheduleResumeSettings",
        "type": "object",
        "x-expandableFields": [],
        "x-stripeMostCommon": [
          "billing_cycle_anchor",
          "payment_behavior",
          "proration_behavior"
        ]
      },
