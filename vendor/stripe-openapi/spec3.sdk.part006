      "subscriptions_resource_trial_settings_end_behavior": {
        "description": "Defines how a subscription behaves when a trial ends.",
        "properties": {
          "billing_cycle_anchor": {
            "description": "Indicates how the subscription's billing cycle anchor is reset when a trial ends. If not set, the default is `now`.",
            "enum": [
              "now",
              "unchanged"
            ],
            "nullable": true,
            "type": "string",
            "x-stripeEnum": {
              "kind": "open",
              "values": [
                {
                  "description": "Reset the subscription's billing cycle anchor to the end of the trial.",
                  "value": "now"
                },
                {
                  "description": "Keep the subscription's existing billing cycle anchor unchanged. This value is unsupported for trials initiated through `trial_end`, `trial_period_days`, or a plan trial.",
                  "value": "unchanged"
                }
              ]
            }
          },
          "missing_payment_method": {
            "description": "Indicates how the subscription should change when the trial ends if the user did not provide a payment method.",
            "enum": [
              "cancel",
              "create_invoice",
              "pause"
            ],
            "type": "string"
          }
        },
        "required": [
          "billing_cycle_anchor",
          "missing_payment_method"
        ],
        "title": "End Behavior",
        "type": "object",
        "x-expandableFields": [],
        "x-stripeMostCommon": [
          "billing_cycle_anchor",
          "missing_payment_method"
        ]
      },
