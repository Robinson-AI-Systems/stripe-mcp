      "three_d_secure.authentication": {
        "description": "The Standalone 3DS API allows you to run EMV 3D Secure (3DS) authentication using Stripe while authorizing the payment with any PSP.\n\nRelated guide: [Standalone 3DS](/payments/3d-secure/standalone-3d-secure)",
        "properties": {
          "acquirer_details": {
            "$ref": "#/components/schemas/three_d_secure_standalone_resource_acquirer_details"
          },
          "amount": {
            "description": "The amount for this 3DS Authentication.",
            "type": "integer"
          },
          "challenge_url": {
            "description": "The URL for presenting a challenge to your cardholder, present if status is requires_challenge.",
            "maxLength": 5000,
            "type": "string"
          },
          "channel": {
            "$ref": "#/components/schemas/three_d_secure_standalone_resource_channel"
          },
          "created": {
            "description": "Time at which the object was created. Measured in seconds since the Unix epoch.",
            "format": "unix-time",
            "type": "integer"
          },
          "currency": {
            "description": "Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).",
            "format": "currency",
            "type": "string"
          },
          "directory_server": {
            "description": "The 3DS directory server with which this 3DS Authentication was processed.",
            "enum": [
              "american_express",
              "cartes_bancaires",
              "discover",
              "mastercard",
              "visa"
            ],
            "type": "string"
          },
          "fingerprinting_url": {
            "description": "The URL for performing issuer fingerprinting, present if fingerprinting is supported for the given payment method.",
            "maxLength": 5000,
            "type": "string"
          },
          "flow_preference": {
            "$ref": "#/components/schemas/three_d_secure_standalone_resource_flow_preference"
          },
          "future_usage": {
            "$ref": "#/components/schemas/three_d_secure_standalone_resource_future_usage"
          },
          "id": {
            "description": "Unique identifier for the object.",
            "maxLength": 5000,
            "type": "string"
          },
          "livemode": {
            "description": "If the object exists in live mode, the value is `true`. If the object exists in test mode, the value is `false`.",
            "type": "boolean"
          },
          "message_category": {
            "description": "Indicates whether this 3DS Authentication is being performed for a payment or non-payment use case.",
            "enum": [
              "non_payment_authentication",
              "payment_authentication"
            ],
            "type": "string"
          },
          "metadata": {
            "additionalProperties": {
              "maxLength": 500,
              "type": "string"
            },
            "description": "Set of [key-value pairs](https://docs.stripe.com/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.",
            "nullable": true,
            "type": "object"
          },
          "object": {
            "description": "String representing the object's type. Objects of the same type share the same value.",
            "enum": [
              "three_d_secure.authentication"
            ],
            "type": "string"
          },
          "outcome": {
            "description": "The outcome of this 3DS Authentication.",
            "enum": [
              "abandoned",
              "attempt_acknowledged",
              "authenticated",
              "canceled",
              "denied",
              "informational",
              "internal_error",
              "not_supported",
              "not_triggered",
              "processing_error",
              "rejected"
            ],
            "type": "string"
          },
          "outcome_details": {
            "$ref": "#/components/schemas/three_d_secure_standalone_resource_outcome_details"
          },
          "payment_method": {
            "anyOf": [
              {
                "maxLength": 5000,
                "type": "string"
              },
              {
                "$ref": "#/components/schemas/payment_method"
              }
            ],
            "description": "ID of the payment method (a PaymentMethod object) to attach to this 3DS Authentication.",
            "x-expansionResources": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/payment_method"
                }
              ]
            }
          },
          "reason": {
            "description": "The reason for invoking this 3DS Authentication.",
            "enum": [
              "cardholder_authentication",
              "issuer_requested",
              "liability_shift",
              "processing_costs",
              "regulatory_compliance"
            ],
            "type": "string",
            "x-stripeEnum": {
              "kind": "open",
              "values": [
                {
                  "description": "The authentication is performed to attempt to require the cardholder to actively complete a challenge.",
                  "value": "cardholder_authentication"
                },
                {
                  "description": "The authentication is performed when the issuer soft declines the transaction. This option should be used when you have tried authorization without 3DS authentication and the bank responded in a soft decline. Stripe will then trigger 3DS, post which you can retry authorization with the issuer.",
                  "value": "issuer_requested"
                },
                {
                  "description": "The authentication is performed to try to shift liability away from the merchant and onto the issuer to reduce the cost implications from disputes.\n\n**Note**: If you don't select `liability_shift` as your reason, the 3DS flow won't prioritize liability shift as a desired outcome. And even when `liability_shift` is selected, liability shift is not guaranteed, since that decision is made by the network and not Stripe([source](/payments/3d-secure/authentication-flow#disputed-payments)).",
                  "value": "liability_shift"
                },
                {
                  "description": "The authentication is performed to optimize payments processing cost.",
                  "value": "processing_costs"
                },
                {
                  "description": "The authentication is performed solely to enable compliance with local regulations such as SCA (Strong Customer Authentication). Use this option when your sole requirement is compliance with local regulations, such as SCA or other 3DS-related mandates. The authentication will be performed only as necessary for compliance purposes.\n\n**Note:** This `reason` parameter value will always apply even when you do not choose this value explicitly.",
                  "value": "regulatory_compliance"
                }
              ]
            }
          },
          "shipping_address": {
            "$ref": "#/components/schemas/three_d_secure_standalone_resource_shipping_address"
          },
          "status": {
            "description": "Status of this Authentication.",
            "enum": [
              "canceled",
              "error",
              "failed",
              "requires_challenge",
              "requires_submission",
              "succeeded"
            ],
            "type": "string",
            "x-stripeBypassValidation": true
          }
        },
        "required": [
          "channel",
          "created",
          "directory_server",
          "id",
          "livemode",
          "message_category",
          "metadata",
          "object",
          "payment_method",
          "status"
        ],
