                    "type": "integer"
                  },
                  "description": {
                    "description": "The description of the credit note line item. Only valid when the `type` is `custom_line_item`.",
                    "maxLength": 5000,
                    "type": "string"
                  },
                  "invoice_line_item": {
                    "description": "The invoice line item to credit. Only valid when the `type` is `invoice_line_item`.",
                    "maxLength": 5000,
                    "type": "string"
