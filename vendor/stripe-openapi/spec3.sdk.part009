                    "type": "object"
                  },
                  "metric_tons": {
                    "description": "Requested number of tons for the order. Either this or `amount` must be specified.",
                    "format": "decimal",
                    "type": "string"
                  },
                  "product": {
                    "description": "Unique identifier of the Climate product.",
