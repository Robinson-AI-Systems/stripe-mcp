      "post": {
        "description": "<p>This endpoint creates a draft invoice for a given customer. The invoice remains a draft until you <a href=\"/api/invoices/finalize\">finalize</a> the invoice, which allows you to <a href=\"/api/invoices/pay\">pay</a> or <a href=\"/api/invoices/send\">send</a> the invoice to your customers.</p>",
        "operationId": "PostInvoices",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "encoding": {
                "account_tax_ids": {
                  "explode": true,
                  "style": "deepObject"
                },
                "automatic_tax": {
                  "explode": true,
                  "style": "deepObject"
                },
                "custom_fields": {
                  "explode": true,
                  "style": "deepObject"
