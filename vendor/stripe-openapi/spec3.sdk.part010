                        "maxLength": 5000,
                        "type": "string"
                      }
                    },
                    "title": "pricing_param",
                    "type": "object",
                    "x-stripeMostCommon": [
                      "price"
                    ]
                  },
                  "quantity": {
                    "description": "Non-negative integer. The quantity of units for the invoice item. Use `quantity_decimal` instead to provide decimal precision. This field will be deprecated in favor of `quantity_decimal` in a future version.",
                    "type": "integer"
