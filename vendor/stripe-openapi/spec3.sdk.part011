                  },
                  "subscription_details": {
                    "description": "The subscription creation or modification params to apply as a preview. Cannot be used with `schedule` or `schedule_details` fields.",
                    "properties": {
                      "billing_cycle_anchor": {
                        "description": "For new subscriptions, a future timestamp to anchor the subscription's [billing cycle](https://docs.stripe.com/subscriptions/billing-cycle). This is used to determine the date of the first full invoice, and, for plans with `month` or `year` intervals, the day of the month for subsequent invoices. For existing subscriptions, the value can only be set to `now` or `unchanged`.",
                        "properties": {
                          "timestamp": {
                            "description": "A timestamp to use as the subscription's billing cycle anchor. Only valid when `type` is `timestamp`.",
                            "format": "unix-time",
                            "type": "integer"
                          },
                          "type": {
                            "description": "Determines how the subscription's billing cycle anchor behaves for the invoice preview.",
                            "enum": [
