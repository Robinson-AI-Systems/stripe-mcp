                                          "description": "No tax is applied as the customer is exempt from tax.",
                                          "value": "customer_exempt"
                                        },
                                        {
                                          "description": "No tax is collected either because you are not registered to collect tax in this jurisdiction, or because the non-taxable product tax code (`txcd_00000000`) was used.",
                                          "value": "not_collecting"
                                        },
                                        {
                                          "description": "No tax is imposed on this transaction.",
                                          "value": "not_subject_to_tax"
                                        },
                                        {
                                          "description": "No tax applied. Stripe doesn’t support this jurisdiction, territory, or product.",
                                          "value": "not_supported"
                                        },
                                        {
                                          "description": "A portion of the price is exempt from tax.",
                                          "value": "portion_product_exempt"
                                        },
                                        {
                                          "description": "A portion of the price is taxed at a reduced rate.",
                                          "value": "portion_reduced_rated"
                                        },
                                        {
                                          "description": "A portion of the price is taxed at the standard rate.",
                                          "value": "portion_standard_rated"
                                        },
                                        {
                                          "description": "The product or service is nontaxable or exempt from tax.",
                                          "value": "product_exempt"
                                        },
                                        {
                                          "description": "The product or service is not taxed due to a sales tax holiday.",
                                          "value": "product_exempt_holiday"
                                        },
                                        {
                                          "description": "The shipping cost tax rate is calculated as a weighted average of the other line items' rates, weighted by their amounts.",
                                          "value": "proportionally_rated"
                                        },
                                        {
                                          "description": "Taxed at a reduced rate.",
                                          "value": "reduced_rated"
                                        },
                                        {
                                          "description": "No tax is applied as it is the responsibility of the buyer to account for tax in this case.",
                                          "value": "reverse_charge"
                                        },
                                        {
                                          "description": "Taxed at the standard rate.",
                                          "value": "standard_rated"
