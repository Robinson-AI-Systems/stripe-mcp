                      "pause": {
                        "description": "Previews the invoice that would be generated when pausing the subscription. Passing an empty hash won't preview pausing and instead returns the next invoice.\n\nTo receive a preview invoice, set `invoicing_behavior` to `invoice`. A preview isn't available if the `bill_for` options produce no billable amounts.\n\n`pending_invoice_item` never has a preview available because pausing wouldn't generate an invoice, and paused subscriptions don't generate invoices either.",
                        "properties": {
                          "bill_for": {
                            "description": "Controls what to bill for when pausing the subscription.",
                            "properties": {
                              "outstanding_usage_through": {
                                "description": "Controls when to bill for metered usage in the current period. Defaults to `{ type: \"now\" }`.",
                                "properties": {
                                  "type": {
                                    "description": "When to bill metered usage in the current period.",
                                    "enum": [
                                      "none",
                                      "now"
                                    ],
                                    "type": "string",
                                    "x-stripeEnum": {
                                      "kind": "open",
                                      "values": [
                                        {
                                          "description": "Don't bill for metered usage in the current period.",
                                          "value": "none"
                                        },
                                        {
                                          "description": "Bill for metered usage in the current period, from current period start to pause time (default).",
                                          "value": "now"
                                        }
                                      ]
                                    }
                                  }
                                },
                                "required": [
                                  "type"
                                ],
                                "title": "outstanding_usage_through_param",
                                "type": "object",
                                "x-stripeMostCommon": [
                                  "type"
                                ]
                              },
                              "unused_time_from": {
                                "description": "Controls when to credit for unused time on licensed items. Defaults to `{ type: \"now\" }`.",
                                "properties": {
                                  "type": {
                                    "description": "When to credit for unused time.",
                                    "enum": [
                                      "item_current_period_start",
                                      "none",
                                      "now"
                                    ],
                                    "type": "string",
                                    "x-stripeEnum": {
                                      "kind": "open",
                                      "values": [
                                        {
                                          "description": "Credit unused time from each item's current period start to period end.",
                                          "value": "item_current_period_start"
                                        },
                                        {
                                          "description": "Don't credit for unused time.",
                                          "value": "none"
                                        },
                                        {
                                          "description": "Credit unused time from pause time to period end (default).",
                                          "value": "now"
                                        }
                                      ]
                                    }
                                  }
                                },
                                "required": [
                                  "type"
                                ],
                                "title": "unused_time_from_param",
                                "type": "object",
                                "x-stripeMostCommon": [
                                  "type"
                                ]
                              }
                            },
                            "title": "bill_for_param",
                            "type": "object",
                            "x-stripeMostCommon": [
                              "outstanding_usage_through",
                              "unused_time_from"
                            ]
                          },
                          "invoicing_behavior": {
                            "description": "Determines how to handle debits and credits when pausing. Defaults to `pending_invoice_item`.",
                            "enum": [
                              "invoice",
                              "pending_invoice_item"
                            ],
                            "type": "string",
                            "x-stripeEnum": {
                              "kind": "open",
                              "values": [
                                {
                                  "description": "Invoices immediately for debits and credits in the current period. If pausing doesn't create any invoice items, Stripe doesn't generate an invoice.",
                                  "value": "invoice"
                                },
                                {
                                  "description": "Creates pending invoice items for debits and credits in the current period.",
                                  "value": "pending_invoice_item"
                                }
                              ]
                            }
                          },
                          "type": {
                            "description": "The type of pause to apply. Defaults to `subscription`.",
                            "enum": [
                              "subscription"
                            ],
                            "type": "string",
                            "x-stripeEnum": {
                              "kind": "open",
                              "values": [
                                {
                                  "description": "Pauses collection, billing, and servicing.",
                                  "value": "subscription"
                                }
                              ]
                            }
                          }
                        },
                        "title": "subscription_details_pause_params",
                        "type": "object",
                        "x-stripeMostCommon": [
                          "bill_for",
                          "invoicing_behavior",
                          "type"
                        ]
                      },
                      "proration_behavior": {
                        "description": "Determines how to handle [prorations](https://docs.stripe.com/billing/subscriptions/prorations) when the billing cycle changes (e.g., when switching plans, resetting `billing_cycle_anchor=now`, or starting a trial), or if an item's `quantity` changes. The default value is `create_prorations`.",
                        "enum": [
                          "always_invoice",
                          "create_prorations",
                          "none"
                        ],
                        "type": "string"
                      },
                      "proration_date": {
                        "description": "If previewing an update to a subscription, and doing proration, `subscription_details.proration_date` forces the proration to be calculated as though the update was done at the specified time. The time given must be within the current subscription period and within the current phase of the schedule backing this subscription, if the schedule exists. If set, `subscription`, and one of `subscription_details.items`, or `subscription_details.trial_end` are required. Also, `subscription_details.proration_behavior` cannot be set to 'none'.",
                        "format": "unix-time",
                        "type": "integer"
                      },
                      "resume_at": {
                        "description": "For paused subscriptions, setting `subscription_details.resume_at` to `now` will preview the invoice that will be generated if the subscription is resumed.",
