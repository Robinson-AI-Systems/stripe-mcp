                                        {
                                          "description": "A reduced amount of the price is subject to tax.",
                                          "value": "taxable_basis_reduced"
                                        },
                                        {
                                          "description": "The transaction is taxed at a special rate of 0% or the transaction is exempt (but these exempt transactions still let you deduct the \"input VAT\" paid on your business purchases).",
                                          "value": "zero_rated"
