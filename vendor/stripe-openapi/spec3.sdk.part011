                                      "display_name",
                                      "inclusive",
                                      "jurisdiction",
                                      "jurisdiction_level",
                                      "percentage",
                                      "state",
                                      "tax_type"
                                    ]
                                  },
                                  "taxability_reason": {
                                    "description": "The reasoning behind this tax, for example, if the product is tax exempt.",
                                    "enum": [
                                      "customer_exempt",
                                      "not_collecting",
                                      "not_subject_to_tax",
                                      "not_supported",
                                      "portion_product_exempt",
                                      "portion_reduced_rated",
                                      "portion_standard_rated",
                                      "product_exempt",
                                      "product_exempt_holiday",
                                      "proportionally_rated",
