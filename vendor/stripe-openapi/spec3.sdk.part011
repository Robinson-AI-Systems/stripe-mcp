                                },
                                {
                                  "description": "Set the subscription's billing cycle anchor to the time specified in `timestamp`.",
                                  "value": "timestamp"
                                },
                                {
                                  "description": "Keep the subscription's existing billing cycle anchor unchanged.",
                                  "value": "unchanged"
                                }
