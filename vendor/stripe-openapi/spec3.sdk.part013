                                    "format": "currency",
                                    "type": "string"
                                  },
                                  "end_date": {
                                    "description": "Date when the mandate expires and no further payments will be charged, in `YYYY-MM-DD`. If not provided, the mandate will be active until canceled. If provided, end date should be after start date.",
                                    "maxLength": 5000,
                                    "type": "string"
                                  },
                                  "payment_schedule": {
