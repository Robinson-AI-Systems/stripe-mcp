                  "payment_method_options": {
                    "description": "Payment method-specific configuration for this PaymentIntent.",
                    "properties": {
                      "acss_debit": {
                        "anyOf": [
                          {
                            "properties": {
                              "mandate_options": {
                                "description": "Additional fields for Mandate creation",
