                  "line_items": {
                    "description": "The line items representing what is being sold. Each line item represents an item being sold. Up to 20 line items are supported.",
                    "items": {
                      "properties": {
                        "adjustable_quantity": {
                          "description": "When set, provides configuration for this item’s quantity to be adjusted by the customer during checkout.",
