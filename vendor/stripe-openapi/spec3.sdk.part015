                  "optional_items": {
                    "description": "A list of optional items the customer can add to their order at checkout. Use this parameter to pass one-time or recurring [Prices](https://docs.stripe.com/api/prices).\nThere is a maximum of 10 optional items allowed on a payment link, and the existing limits on the number of line items allowed on a payment link apply to the combined number of line items and optional items.\nThere is a maximum of 20 combined line items and optional items.",
                    "items": {
                      "properties": {
                        "adjustable_quantity": {
                          "description": "When set, provides configuration for the customer to adjust the quantity of the line item created when a customer chooses to add this optional item to their order.",
                          "properties": {
                            "enabled": {
                              "description": "Set to true if the quantity can be adjusted to any non-negative integer.",
                              "type": "boolean"
                            },
                            "maximum": {
                              "description": "The maximum quantity of this item the customer can purchase. By default this value is 99.",
                              "type": "integer"
                            },
                            "minimum": {
                              "description": "The minimum quantity of this item the customer must purchase, if they choose to purchase it. Because this item is optional, the customer will always be able to remove it from their order, even if the `minimum` configured here is greater than 0. By default this value is 0.",
                              "type": "integer"
                            }
                          },
