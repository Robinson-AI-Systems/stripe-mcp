                          }
                        ],
                        "description": "Billing phone number (including extension)."
                      },
                      "tax_id": {
                        "description": "Taxpayer identification number. Used only for transactions between LATAM buyers and non-LATAM sellers.",
                        "maxLength": 5000,
                        "type": "string"
                      }
