                                  "user_agent"
                                ]
                              },
                              "type": {
                                "description": "The type of customer acceptance information included with the Mandate. One of `online` or `offline`.",
                                "enum": [
                                  "offline",
                                  "online"
                                ],
                                "maxLength": 5000,
                                "type": "string"
                              }
