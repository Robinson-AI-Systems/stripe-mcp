                                    "enum": [
                                      ""
                                    ],
                                    "type": "string"
                                  }
                                ],
                                "description": "Date, in YYYY-MM-DD format, after which payments will not be collected. Defaults to no end date."
                              },
                              "payment_schedule": {
                                "description": "The periodicity at which payments will be collected. Defaults to `adhoc`.",
                                "enum": [
                                  "",
