                            },
                            "settings": {
                              "description": "Settings controlling billing behavior during the pause.",
                              "properties": {
                                "bill_for": {
                                  "description": "Controls what to bill for when pausing the subscription.",
                                  "properties": {
                                    "outstanding_usage_through": {
                                      "description": "Controls whether to collect metered usage accrued up to the pause date.",
                                      "properties": {
                                        "type": {
                                          "description": "Determines whether to collect metered usage accrued up to the pause date. When adding a pause schedule, defaults to `pause_at`. On updates, the existing value is preserved if not provided.",
                                          "enum": [
                                            "none",
                                            "pause_at"
                                          ],
                                          "type": "string",
                                          "x-stripeEnum": {
                                            "kind": "open",
                                            "values": [
                                              {
                                                "description": "Do not collect outstanding metered usage.",
                                                "value": "none"
                                              },
                                              {
                                                "description": "Collect metered usage accrued through the pause date.",
                                                "value": "pause_at"
                                              }
                                            ]
                                          }
                                        }
                                      },
                                      "title": "pause_settings_bill_for_outstanding_usage_through_params",
                                      "type": "object",
                                      "x-stripeMostCommon": [
                                        "type"
                                      ]
                                    },
                                    "unused_time_from": {
                                      "description": "Controls how unused time on subscription items is credited when pausing.",
                                      "properties": {
                                        "type": {
                                          "description": "Determines which point in the billing period unused time is credited from. When adding a pause schedule, defaults to `pause_at`. On updates, the existing value is preserved if not provided.",
                                          "enum": [
                                            "item_current_period_start",
                                            "none",
                                            "pause_at"
                                          ],
                                          "type": "string",
                                          "x-stripeEnum": {
                                            "kind": "open",
                                            "values": [
                                              {
                                                "description": "Credit unused time from the start of each item's current billing period.",
                                                "value": "item_current_period_start"
                                              },
                                              {
                                                "description": "Do not credit unused time.",
                                                "value": "none"
                                              },
                                              {
                                                "description": "Credit unused time from the pause date.",
                                                "value": "pause_at"
                                              }
                                            ]
                                          }
                                        }
                                      },
                                      "title": "pause_settings_bill_for_unused_time_from_params",
                                      "type": "object",
                                      "x-stripeMostCommon": [
                                        "type"
                                      ]
                                    }
                                  },
                                  "title": "pause_settings_bill_for_params",
                                  "type": "object",
