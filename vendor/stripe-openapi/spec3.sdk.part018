                                "type"
                              ]
                            },
                            "start": {
                              "description": "Start of the invoice item period.",
                              "properties": {
                                "timestamp": {
                                  "description": "A precise Unix timestamp for the start of the invoice item period. Must be less than or equal to `period.end`.",
                                  "format": "unix-time",
                                  "type": "integer"
                                },
