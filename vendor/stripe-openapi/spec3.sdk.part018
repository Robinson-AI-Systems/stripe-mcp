                                    "outstanding_usage_through",
                                    "unused_time_from"
                                  ]
                                },
                                "invoicing_behavior": {
                                  "description": "Determines whether to generate an invoice for outstanding amounts when pausing. When adding a pause schedule, defaults to `pending_invoice_item`. On updates, the existing value is preserved if not provided.",
                                  "enum": [
                                    "invoice",
                                    "pending_invoice_item"
                                  ],
                                  "type": "string",
                                  "x-stripeEnum": {
                                    "kind": "open",
                                    "values": [
                                      {
                                        "description": "Invoices immediately for debits and credits in the current period. If pausing doesn't create any invoice items, Stripe doesn't generate an invoice.",
                                        "value": "invoice"
                                      },
                                      {
                                        "description": "Creates pending invoice items for debits and credits in the current period.",
                                        "value": "pending_invoice_item"
                                      }
                                    ]
                                  }
                                },
                                "type": {
                                  "description": "The pause type. Currently only `subscription` is supported.",
                                  "enum": [
                                    "subscription"
                                  ],
                                  "type": "string",
                                  "x-stripeEnum": {
                                    "kind": "open",
                                    "values": [
                                      {
                                        "description": "Pauses collection, billing, and servicing.",
                                        "value": "subscription"
                                      }
