                          "title": "transfer_data_specs",
                          "type": "object",
                          "x-stripeMostCommon": [
                            "amount_percent",
                            "destination"
                          ]
                        },
                        "trial": {
                          "description": "If set to true the entire phase is counted as a trial and the customer will not be charged for any fees.",
                          "type": "boolean"
                        },
                        "trial_end": {
                          "description": "Sets the phase to trialing from the start date to this date. Must be before the phase end date, can not be combined with `trial`",
                          "format": "unix-time",
