    "/v1/subscriptions/{subscription}/pause": {
      "post": {
        "description": "<p>Pauses a subscription by transitioning it to the paused status. A paused subscription does not generate invoices and will not advance to new billing periods. The subscription can be resumed later using the resume endpoint. Cannot pause subscriptions with attached schedules.</p>",
        "operationId": "PostSubscriptionsSubscriptionPause",
        "parameters": [
          {
            "in": "path",
            "name": "subscription",
            "required": true,
            "schema": {
              "maxLength": 5000,
              "type": "string"
            },
            "style": "simple",
            "x-stripeLessCommon": true
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "encoding": {
                "bill_for": {
                  "explode": true,
                  "style": "deepObject"
                },
                "expand": {
                  "explode": true,
                  "style": "deepObject"
                }
              },
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "bill_for": {
                    "description": "Controls what to bill for when pausing the subscription.",
                    "properties": {
                      "outstanding_usage_through": {
                        "description": "Controls when to bill for metered usage in the current period. Defaults to `{ type: \"now\" }`.",
                        "properties": {
                          "type": {
                            "description": "When to bill metered usage in the current period.",
                            "enum": [
                              "none",
                              "now"
                            ],
                            "type": "string",
                            "x-stripeEnum": {
                              "kind": "open",
                              "values": [
                                {
                                  "description": "Don't bill for metered usage in the current period.",
                                  "value": "none"
                                },
                                {
                                  "description": "Bill for metered usage in the current period, from current period start to pause time (default).",
                                  "value": "now"
                                }
                              ]
                            }
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "title": "outstanding_usage_through_param",
                        "type": "object",
                        "x-stripeMostCommon": [
                          "type"
                        ]
                      },
                      "unused_time_from": {
                        "description": "Controls when to credit for unused time on licensed items. Defaults to `{ type: \"now\" }`.",
                        "properties": {
                          "type": {
                            "description": "When to credit for unused time.",
                            "enum": [
                              "item_current_period_start",
                              "none",
                              "now"
                            ],
                            "type": "string",
                            "x-stripeEnum": {
                              "kind": "open",
                              "values": [
                                {
                                  "description": "Credit unused time from each item's current period start to period end.",
                                  "value": "item_current_period_start"
                                },
                                {
                                  "description": "Don't credit for unused time.",
                                  "value": "none"
                                },
                                {
                                  "description": "Credit unused time from pause time to period end (default).",
                                  "value": "now"
                                }
                              ]
                            }
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "title": "unused_time_from_param",
                        "type": "object",
                        "x-stripeMostCommon": [
                          "type"
                        ]
                      }
                    },
                    "title": "bill_for_param",
                    "type": "object",
                    "x-stripeMostCommon": [
                      "outstanding_usage_through",
                      "unused_time_from"
                    ]
                  },
                  "expand": {
                    "description": "Specifies which fields in the response should be expanded.",
                    "items": {
                      "maxLength": 5000,
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "invoicing_behavior": {
                    "description": "Determines how to handle debits and credits when pausing. Defaults to `pending_invoice_item`.",
                    "enum": [
                      "invoice",
                      "pending_invoice_item"
                    ],
                    "type": "string",
                    "x-stripeEnum": {
                      "kind": "open",
                      "values": [
                        {
                          "description": "Invoices immediately for debits and credits in the current period. If pausing doesn't create any invoice items, Stripe doesn't generate an invoice.",
                          "value": "invoice"
                        },
                        {
                          "description": "Creates pending invoice items for debits and credits in the current period.",
                          "value": "pending_invoice_item"
                        }
                      ]
                    }
                  },
                  "type": {
                    "description": "The type of pause to apply. Defaults to `subscription`.",
                    "enum": [
                      "subscription"
                    ],
                    "type": "string",
                    "x-stripeEnum": {
                      "kind": "open",
                      "values": [
                        {
                          "description": "Pauses collection, billing, and servicing.",
                          "value": "subscription"
                        }
                      ]
                    }
                  }
                },
                "type": "object",
                "x-stripeMostCommon": [
                  "bill_for",
                  "invoicing_behavior",
                  "type"
                ]
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/subscription"
                }
              }
            },
            "description": "Successful response."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            },
            "description": "Error response."
          }
        },
        "summary": "Pause a subscription",
        "x-stableId": "pause_billing_subscription"
      }
    },
    "/v1/subscriptions/{subscription}/resume": {
      "post": {
        "description": "<p>Initiates resumption of a paused subscription, optionally resetting the billing cycle anchor and creating prorations. Resume is only available for subscriptions that use <code>charge_automatically</code> collection. If Stripe doesn’t generate a resumption invoice, the subscription becomes <code>active</code> immediately. When a resumption invoice is generated, Stripe finalizes it immediately. If the invoice is paid or marked uncollectible, the subscription becomes <code>active</code>. If the invoice is manually voided, the subscription stays <code>paused</code>. If there is no payment attempt within 23 hours, Stripe voids the invoice and the subscription stays <code>paused</code>. Learn more about <a href=\"/docs/billing/subscriptions/pause#resume-subscriptions\">resuming subscriptions</a>.</p>",
        "operationId": "PostSubscriptionsSubscriptionResume",
        "parameters": [
          {
            "in": "path",
            "name": "subscription",
            "required": true,
            "schema": {
              "maxLength": 5000,
              "type": "string"
            },
            "style": "simple",
            "x-stripeLessCommon": true
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "encoding": {
                "billing_cycle_anchor": {
                  "explode": true,
                  "style": "deepObject"
                },
                "expand": {
                  "explode": true,
                  "style": "deepObject"
                }
              },
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "billing_cycle_anchor": {
                    "description": "The billing cycle anchor that applies when the subscription is resumed. Either `now` or `unchanged`. The default is `now`. For more information, see the billing cycle [documentation](https://docs.stripe.com/billing/subscriptions/billing-cycle).",
                    "properties": {
                      "type": {
                        "description": "Determines how the billing cycle anchor changes when the subscription resumes.",
                        "enum": [
                          "now",
                          "unchanged"
                        ],
                        "type": "string",
                        "x-stripeBypassValidation": true
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "title": "billing_cycle_anchor_param",
                    "type": "object",
                    "x-stripeMostCommon": [
                      "timestamp",
                      "type"
                    ]
                  },
                  "expand": {
                    "description": "Specifies which fields in the response should be expanded.",
                    "items": {
                      "maxLength": 5000,
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "payment_behavior": {
                    "description": "Controls whether Stripe attempts payment on the resumption invoice in the resume request, and how payment on that invoice affects the subscription's status. The default is `resume_on_payment_attempt`.",
                    "enum": [
                      "resume_on_payment_attempt",
                      "resume_on_payment_success"
                    ],
                    "type": "string",
                    "x-stripeEnum": {
                      "kind": "open",
                      "values": [
                        {
                          "description": "If you create a resumption invoice, Stripe finalizes the invoice immediately but doesn't attempt payment. You can then manually attempt payment on the invoice using the [Pay invoice endpoint](/api/invoices/pay). If the payment attempt succeeds, the subscription becomes `active`. If the payment attempt fails, the subscription becomes `past_due`. If the invoice has no payment attempts after 23 hours, Stripe voids the invoice and the subscription remains `paused`.",
                          "value": "resume_on_payment_attempt"
                        },
                        {
                          "description": "If you create a resumption invoice, Stripe finalizes and attempts payment on the invoice immediately. If that payment attempt succeeds, the subscription becomes `active`. If that payment attempt fails, the subscription remains `paused`. You can then manually attempt payment on the invoice using the [Pay invoice endpoint](/api/invoices/pay). If the invoice isn't paid successfully within 1 year of its creation, Stripe voids the invoice and the subscription remains `paused`.",
                          "value": "resume_on_payment_success"
                        }
                      ]
                    }
                  },
                  "proration_behavior": {
                    "description": "Determines how to handle [prorations](https://docs.stripe.com/billing/subscriptions/prorations) resulting from the `billing_cycle_anchor` being `unchanged`. When the `billing_cycle_anchor` is set to `now` (default value), no prorations are generated. If no value is passed, the default is `create_prorations`.",
                    "enum": [
                      "always_invoice",
                      "create_prorations",
                      "none"
                    ],
                    "type": "string"
                  },
                  "proration_date": {
                    "description": "If set, prorations will be calculated as though the subscription was resumed at the given time. This can be used to apply exactly the same prorations that were previewed with the [create preview](https://stripe.com/docs/api/invoices/create_preview) endpoint.",
                    "format": "unix-time",
                    "type": "integer"
                  }
                },
                "type": "object",
                "x-stripeMostCommon": [
                  "billing_cycle_anchor",
                  "proration_behavior"
                ]
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/subscription"
                }
              }
            },
            "description": "Successful response."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            },
            "description": "Error response."
          }
        },
        "summary": "Resume a subscription",
        "x-stableId": "resume_billing_subscription"
      }
    },
