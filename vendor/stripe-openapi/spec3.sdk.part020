                              "odometer",
                              "unspecified_id",
                              "user_id",
                              "vehicle_number"
                            ]
                          },
                          "purchase_type": {
                            "description": "The type of purchase. One of `fuel_purchase`, `non_fuel_purchase`, or `fuel_and_non_fuel_purchase`.",
                            "enum": [
                              "fuel_and_non_fuel_purchase",
                              "fuel_purchase",
                              "non_fuel_purchase"
                            ],
                            "maxLength": 5000,
                            "type": "string"
                          },
                          "reported_breakdown": {
