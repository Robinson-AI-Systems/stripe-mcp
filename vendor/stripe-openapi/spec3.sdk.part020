                              "national_amount_decimal"
                            ]
                          }
                        },
                        "title": "fleet_reported_breakdown_specs",
                        "type": "object",
                        "x-stripeMostCommon": [
                          "fuel",
                          "non_fuel",
                          "tax"
                        ]
                      },
                      "service_type": {
                        "description": "The type of fuel service. One of `non_fuel_transaction`, `full_service`, or `self_service`.",
                        "enum": [
                          "full_service",
                          "non_fuel_transaction",
                          "self_service"
                        ],
                        "maxLength": 5000,
                        "type": "string"
                      }
